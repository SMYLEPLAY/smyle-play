# SMYLE PLAY — Variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs réelles (le .env est
# gitignoré). Sur Railway, ces mêmes clés se posent dans Variables.
#
# Ce fichier est aligné sur watt-api/app/config.py (classe Settings), qui est
# la SEULE source de vérité : toute variable ajoutée là doit apparaître ici.
# Flask a été supprimé le 2026-07-30 (P0-c) — les clés FLASK_* ont disparu.

# ── Environnement ─────────────────────────────────────────────────────────────
# development | production | test  (test désactive slowapi et le pool)
ENVIRONMENT=development
# Port d'écoute d'uvicorn en local (Railway le fournit lui-même).
PORT=8080

# ── Sécurité / JWT ────────────────────────────────────────────────────────────
# OBLIGATOIRE en production, >= 32 octets, aléatoire. Le serveur REFUSE de
# démarrer sur un placeholder ou une clé plus courte : une clé plus courte fait
# signer les JWT avec un secret trop faible pour HS256
# (app/config.py::assert_secret_key_strong).
# Générer :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Vérification d'email (Phase A — ouverture gratuite) ───────────────────────
# NON bloquant par défaut. false → le login n'exige PAS un email vérifié (on
# n'enferme pas dehors les comptes bêta existants). Passer à true (sur Railway,
# sans redéploiement) exigera un email vérifié au login — à n'activer qu'une
# fois l'envoi d'emails fiable et une page /verifier-email en place.
REQUIRE_EMAIL_VERIFIED=false

# ── BRIQUE 2 — programme PIONNIER (100 premiers créateurs) ────────────────────
# false (défaut) : aucun effet — ni attribution en direct, ni compteur public,
#   ni taux Pionnier (10 %) appliqué aux ventes.
# true : attribution à la première publication d'une œuvre, compteur public
#   « places restantes », taux Pionnier appliqué. Ordre recommandé : lancer le
#   rattrapage depuis la page admin (aperçu puis confirmation) AVANT de passer
#   ce drapeau à true, pour que les rangs suivent l'ordre réel de publication.
# Règle email : non exigée au rattrapage ; exigée en direct seulement si
#   REQUIRE_EMAIL_VERIFIED=true.
FEATURE_PIONEER=false

# ── Base de données PostgreSQL ────────────────────────────────────────────────
# OBLIGATOIRE (aucun défaut, aucun repli SQLite : la chaîne Alembic utilise des
# types Postgres). Railway fournit DATABASE_URL avec le plugin PostgreSQL.
# postgres:// et postgresql:// sont normalisés en postgresql+asyncpg:// au boot.
DATABASE_URL=postgresql://dev:dev@localhost:5432/smyleplay

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules. En prod : l'URL publique.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── URL publique (liens absolus des emails) ───────────────────────────────────
# Origine des liens absolus envoyés par email — aujourd'hui le lien de
# réinitialisation de mot de passe (watt-api/app/routers/auth.py, S-10).
# Défaut : vide → repli sur l'origine de la requête, donc sur l'en-tête Host,
# qu'un intermédiaire peut falsifier : à POSER en production.
PUBLIC_BASE_URL=

# ── Cloudflare R2 (stockage audio + images) ───────────────────────────────────
# Deux conventions coexistent ; les noms « modernes » sont prioritaires et les
# alias legacy Railway sont résolus automatiquement (cf. effective_r2_*).
# Valeurs : Cloudflare Dashboard → R2 → Manage API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
# Alias legacy (utilisés seulement si les trois clés ci-dessus sont vides) :
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_ACCOUNT_ID=          # construit R2_ENDPOINT_URL si celui-ci est absent
R2_BUCKET=smyle-play-audio
# Bucket PRIVÉ des images ORIGINALES payantes. Vide → repli sur R2_BUCKET
# (comportement actuel, sans rupture) ; défini → les originaux y sont isolés.
R2_PRIVATE_BUCKET=
# Domaine public r2.dev du bucket public (sert à rediriger le proxy d'images).
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev

# ── MODE LANCEMENT (masquage réversible des points d'entrée) ──────────────────
# Un item est VISIBLE si : (not MODE_LANCEMENT) or SHOW_<ITEM>.
# Défauts du code : tout masqué. Rallumer = passer un SHOW_* à true.
MODE_LANCEMENT=true
SHOW_PALIERS=false
SHOW_RESALE=false
SHOW_PACKS=false
SHOW_VOIX=false
SHOW_TROC=false
SHOW_THE_PLAN=false
# Achat de Smyles (modale d'achat) — masqué tant que Stripe n'est pas branché
# (/credits/grant répond 403 hors compte officiel). Défaut : false.
SHOW_ACHAT_SMYLES=false
# Toute surface qui chiffre en EUROS (page /tarifs, repère Smyles du dashboard,
# aperçus « ≈ X€ ») — masquée tant que Stripe n'est pas branché. Défaut : false.
SHOW_EUROS=false

# ── BRIQUE 1 — marché interne en Smyles (commission encaissée) ────────────────
# false (défaut) : la commission plateforme est seulement tracée au ledger et
#   n'est créditée à personne — comportement historique, inchangé.
# true : cette même commission est encaissée par le compte trésorerie société,
#   dans le bucket NON retirable. Ni les prix, ni le split, ni la part vendeur
#   ne changent. Bascule réversible sans perte (le ledger reste la source de
#   vérité : SUM(transactions.platform_fee)).
FEATURE_MARKET_SMYLES=false

# ── Observabilité ─────────────────────────────────────────────────────────────
# Vide → Sentry ne s'initialise pas du tout (no-op complet).
SENTRY_DSN=

# ── Emails transactionnels (Resend) ───────────────────────────────────────────
# Vide → les envois sont DÉSACTIVÉS proprement (aucune erreur, aucun envoi).
RESEND_API_KEY=
EMAIL_FROM=WATT <onboarding@resend.dev>
# Destinataire de l'alerte « nouveau signalement » (app/routers/reports.py).
# Défaut : vide → aucun email de modération n'est envoyé (le reste fonctionne).
REPORT_NOTIFY_EMAIL=

# ── Clerk (non utilisé en prod : l'auth passe par le JWT interne) ─────────────
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# ── Scripts locaux hérités (racine : watcher_pipeline.py, server.py,
#     upload_to_r2.py, config.py) — PAS lus par watt-api/app/config.py ─────────
# Base publique des audio pour le pipeline de scan local.
CLOUD_AUDIO_BASE_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev
