<?xml version="1.0" encoding="UTF-8"?>
<!--
  WATT — LaunchAgent du RELAIS DE DEPLOIEMENT AUTONOME
  ==========================================================
  Lance le relais en mode «once» :
    • instantanement quand une tache est deposee dans .relay/queue
      (WatchPaths) ;
    • et toutes les 120 s en filet (StartInterval) pour re-verifier la CI
      des PR en attente et merger celles devenues vertes.

  Installation :
    cp com.smyleplay.relay.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.smyleplay.relay.plist

  Désinstallation :
    launchctl unload ~/Library/LaunchAgents/com.smyleplay.relay.plist
    rm ~/Library/LaunchAgents/com.smyleplay.relay.plist

  Pause sans désinstaller : créer le fichier .relay/PAUSE dans le projet.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smyleplay.relay</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "/Users/tommio/Desktop/WORK/Smyleplay" &amp;&amp; scripts/smyle-relay.sh --once</string>
  </array>

  <!-- Déclenchement instantané dès qu'une tâche est déposée en file -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/tommio/Desktop/WORK/Smyleplay/.relay/queue</string>
  </array>

  <!-- Filet : re-vérifie la CI des PR en attente toutes les 120 s -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Merge admin autorisé MAIS uniquement après que le relais a vérifié la
         CI verte (gh pr checks). Mets 0 pour exiger une protection sans admin. -->
    <key>RELAY_ADMIN</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/tommio/Desktop/WORK/Smyleplay/.relay/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tommio/Desktop/WORK/Smyleplay/.relay/launchd.err.log</string>
</dict>
</plist>
